# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOMENTE servidor. Nunca prefixar com NEXT_PUBLIC_, nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
# URL pública (sem barra final). Ex.: https://heresias.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Exige MFA (TOTP) concluído para acessar /admin ("true" em produção)
REQUIRE_ADMIN_MFA=true
# Segredo aleatório (32+ chars) usado para anonimizar IPs no rate limit
RATE_LIMIT_SALT=

# Notificações push (Instantes e publicações). Gere o par com: npx web-push generate-vapid-keys
# A chave pública pode ser vista no app; a PRIVADA é secreta (só na Vercel, nunca no código).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
